# ============================================================
# Brain Tumor Agentic AI — Configuration
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Mode applicatif ---
# DEMO             : fonctionne sans modèle ni clé API (simulation)
# PRODUCTION_READY : utilise EfficientNet-B0 + Gemini/Mistral réels
APP_MODE=DEMO

# --- Provider LLM ---
# gemini  : Google Gemini (nécessite GEMINI_API_KEY)
# mistral : Mistral AI    (nécessite MISTRAL_API_KEY)
# mock    : mode fallback sans LLM externe (par défaut)
# auto    : détection automatique selon les clés disponibles
LLM_PROVIDER=mock

# --- Google Gemini ---
# Obtenez votre clé sur : https://aistudio.google.com/
# SDK utilisé : google-genai (pip install google-genai)
GEMINI_API_KEY=
# Modèles disponibles : gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# --- Mistral AI ---
# Obtenez votre clé sur : https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- PubMed / NCBI ---
PUBMED_EMAIL=votre-email@example.com
ENABLE_PUBMED=false
ENABLE_NCI_FALLBACK=true
